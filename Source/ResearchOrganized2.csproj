<Project Sdk="Microsoft.NET.Sdk">
  <!-- Build settings, game references, and assembly staging are repository-local. -->
  <PropertyGroup>
    <RootNamespace>ResearchOrganized2</RootNamespace>
    <AssemblyName>ResearchOrganized2</AssemblyName>
    <UnityModules>CoreModule;IMGUIModule;TextRenderingModule</UnityModules>
  </PropertyGroup>

  <!-- The UI Rethemed add-on is its own project, built against UI Rethemed - Core. -->
  <ItemGroup>
    <Compile Remove="UIRethemed\**" />
    <None Remove="UIRethemed\**" />
  </ItemGroup>
</Project>
